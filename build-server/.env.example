# Build Server Configuration
# Copy this to .env and fill in your values

# ── Server ─────────────────────────────────────────────
PORT=4000

# ── Webhook Authentication ──────────────────────────────
# Shared secret used to verify GitHub Actions webhook payloads (HMAC-SHA256)
# Must match the BUILD_SERVER_TOKEN GitHub Secret exactly
BUILD_SERVER_TOKEN=your-random-secret-here

# ── Cosign / Sigstore ───────────────────────────────────
# Your GitHub org/repo (e.g. "prajwalch/supplychainattest")
GITHUB_REPO=YOUR_GITHUB_USERNAME/supplychainattest

# The exact workflow file that is trusted to sign images
TRUSTED_WORKFLOW=protected.yml

# The git branch trusted for signing
TRUSTED_BRANCH=main

# ── Docker ─────────────────────────────────────────────
APP_CONTAINER_NAME=supplychainattest-app
APP_PORT=3000
